___TESTS___

scenarios:
- name: Injects the loader after setting the configuration object
  code: |-
    runCode({
      siteKey: ' ls_abcdefghijklmnopqrstuvwxyz0123456789a ',
      environment: 'Staging',
      build: 'a1b2c3d',
      apiBase: ''
    });

    assertApi('setInWindow').wasCalledWith('__deploysealConfig', {
      dsSiteKey: 'ls_abcdefghijklmnopqrstuvwxyz0123456789a',
      dsInstaller: 'gtm-template/1.0.0',
      dsEnvironment: 'staging',
      dsBuild: 'a1b2c3d'
    }, false);
    assertThat(injected.length).isEqualTo(1);
    assertThat(injected[0].url).isEqualTo('https://cdn.deployseal.com/ds-widget.js');
    assertThat(injected[0].cacheToken).isEqualTo('deployseal');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Empty optional fields are omitted, never set to an empty string
  code: |-
    runCode({ siteKey: 'ls_key', environment: '', build: '', apiBase: '' });

    assertThat(stored).isEqualTo({ dsSiteKey: 'ls_key', dsInstaller: 'gtm-template/1.0.0' });
    assertApi('gtmOnSuccess').wasCalled();
- name: The placeholder build marker is never sent
  code: |-
    runCode({ siteKey: 'ls_key', build: ' replace-with-build-marker ' });

    assertThat(stored.dsBuild).isUndefined();
- name: API base is kept without a trailing slash
  code: |-
    runCode({ siteKey: 'ls_key', apiBase: 'https://api.preview.example.com/' });

    assertThat(stored.dsApiBase).isEqualTo('https://api.preview.example.com');
- name: Environment is slugified like slugifyEnvironmentLabel
  code: |-
    const cases = [
      ['Staging', 'staging'],
      ['Production', 'production'],
      ['UAT 2', 'uat-2'],
      ['  Pre-Prod (EU) ', 'pre-prod-eu'],
      ['Ünïcode Ärger', 'n-code-rger'],
      ['a_b.c/d', 'a-b-c-d'],
      ['aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa tail', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'],
      ['bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb']
    ];
    for (let i = 0; i < cases.length; i++) {
      stored = undefined;
      runCode({ siteKey: 'ls_key', environment: cases[i][0] });
      assertThat(stored.dsEnvironment).isEqualTo(cases[i][1]);
    }
- name: An environment with nothing left after slugifying is omitted
  code: |-
    runCode({ siteKey: 'ls_key', environment: '---' });

    assertThat(stored.dsEnvironment).isUndefined();
- name: Empty site key fails and injects nothing
  code: |-
    runCode({ siteKey: '   ', environment: 'staging' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('setInWindow').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
- name: Already installed (configuration object set) injects nothing
  code: |-
    existing = { dsSiteKey: 'ls_snippet' };
    runCode({ siteKey: 'ls_key', environment: 'staging' });

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('setInWindow').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
- name: Already installed (widget mounted) injects nothing
  code: |-
    mounted = { version: '1.0.0', siteKey: 'ls_snippet' };
    runCode({ siteKey: 'ls_key' });

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('injectScript').wasNotCalled();
- name: A failed script load reports failure
  code: |-
    loadFails = true;
    runCode({ siteKey: 'ls_key' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  let existing;
  let mounted;
  let stored;
  let loadFails = false;
  const injected = [];

  mock('copyFromWindow', function(key) {
    if (key === '__deploysealConfig') return existing;
    if (key === '__deployseal') return mounted;
    return undefined;
  });
  mock('setInWindow', function(key, value, override) {
    if (key !== '__deploysealConfig' || existing) return false;
    stored = value;
    return true;
  });
  mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
    injected.push({ url: url, cacheToken: cacheToken });
    if (loadFails) onFailure(); else onSuccess();
  });


