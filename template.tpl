___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// DeploySeal widget tag — install contract v1.4 §10 (the configuration object).
// injectScript cannot put data-ds-* attributes on the tag it inserts, so the
// configuration is written to window.__deploysealConfig first; the widget's
// loader keeps an object that is already set, and the widget reads it.

const copyFromWindow = require('copyFromWindow');
const injectScript = require('injectScript');
const makeString = require('makeString');
const setInWindow = require('setInWindow');

const WIDGET_URL = 'https://cdn.deployseal.com/ds-widget.js';
const CONFIG_GLOBAL = '__deploysealConfig';
const INSTALLER = 'gtm-template/1.0.0';
const BUILD_MARKER_PLACEHOLDER = 'REPLACE-WITH-BUILD-MARKER';
const ENVIRONMENT_LABEL_MAX = 32;
const BUILD_MARKER_MAX = 64;
const SLUG_ALPHABET = 'abcdefghijklmnopqrstuvwxyz0123456789';

// Text from a field: '' for an empty field or an undefined variable.
function text(value) {
  if (value === undefined || value === null) return '';
  return makeString(value).trim();
}

// slugifyEnvironmentLabel from @deployseal/shared, without regular expressions:
// lower-case; each run of characters outside [a-z0-9] becomes one hyphen;
// no leading or trailing hyphen; at most 32 characters.
function slugifyEnvironmentLabel(value) {
  const lower = text(value).toLowerCase();
  let out = '';
  let gap = false;
  for (let i = 0; i < lower.length; i++) {
    const c = lower.charAt(i);
    if (SLUG_ALPHABET.indexOf(c) >= 0) {
      if (gap && out.length > 0) out = out + '-';
      out = out + c;
      gap = false;
    } else {
      gap = true;
    }
  }
  out = out.substring(0, ENVIRONMENT_LABEL_MAX);
  while (out.length > 0 && out.charAt(out.length - 1) === '-') {
    out = out.substring(0, out.length - 1);
  }
  return out;
}

function buildMarker(value) {
  const marker = text(value).substring(0, BUILD_MARKER_MAX);
  if (marker.toUpperCase() === BUILD_MARKER_PLACEHOLDER) return '';
  return marker;
}

function apiBase(value) {
  let base = text(value);
  while (base.length > 0 && base.charAt(base.length - 1) === '/') {
    base = base.substring(0, base.length - 1);
  }
  return base;
}

// First writer wins: a snippet, a plugin or another DeploySeal tag already
// configured (or mounted) the widget on this page. Insert nothing.
if (copyFromWindow(CONFIG_GLOBAL) || copyFromWindow('__deployseal')) {
  data.gtmOnSuccess();
  return;
}

const siteKey = text(data.siteKey);
if (!siteKey) {
  // Typically a Lookup Table with no row for this hostname: load nothing.
  data.gtmOnFailure();
  return;
}

// Keys whose value would be empty are omitted, never set to '' (§10).
const config = { dsSiteKey: siteKey, dsInstaller: INSTALLER };
const environment = slugifyEnvironmentLabel(data.environment);
if (environment) config.dsEnvironment = environment;
const build = buildMarker(data.build);
if (build) config.dsBuild = build;
const base = apiBase(data.apiBase);
if (base) config.dsApiBase = base;

if (!setInWindow(CONFIG_GLOBAL, config, false)) {
  // Set between the check above and now: someone else is installing it.
  data.gtmOnSuccess();
  return;
}

injectScript(WIDGET_URL, data.gtmOnSuccess, data.gtmOnFailure, 'deployseal');


